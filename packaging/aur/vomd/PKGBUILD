# Maintainer: Allen Guarnes <allen@ggbite.com>
# Builds from the tagged source. After tagging a release: bump pkgver, run `updpkgsums` and
# `makepkg --printsrcinfo > .SRCINFO`, then push to the AUR.
# This package honors makepkg.conf: its RUSTFLAGS (CachyOS: `-C opt-level=3 -C target-cpu=native`)
# override the repository's opt-level="z", so the binary is larger and faster than the release
# one, and runs on the build machine's CPU only. `vomd-bin` is the small one. (It still leaves out
# the unwind tables, as `cargo xtask dist` does, unless those RUSTFLAGS choose mold or gold.)
pkgname=vomd
pkgver=1.10.0
pkgrel=1
pkgdesc='View-Only Markdown: a tiny, fast Markdown viewer'
arch=('x86_64' 'aarch64')
url='https://github.com/allenguarnes/vomd'
license=('MIT' 'OFL-1.1' 'ISC')
# The display libraries are loaded at run time (dlopen), for Wayland or X11, whichever the
# session is: namcap can't see them.
depends=('glibc' 'libgcc' 'hicolor-icon-theme' 'libxkbcommon' 'wayland'
         'libx11' 'libxcb' 'libxcursor' 'libxi' 'libxkbcommon-x11')
makedepends=('cargo')
# Open (Ctrl+O) needs a file dialog: KDE and GNOME already provide a portal file chooser
# (xdg-desktop-portal-kde, -gnome); the three below are for other desktops.
optdepends=('curl: remote images, loaded only after pressing I'
            'xdg-utils: open web links in the browser'
            'xdg-desktop-portal-gtk: the file dialog for Open (Ctrl+O) on desktops without a portal file chooser, such as Hyprland and Sway'
            'zenity: a file dialog for Open (Ctrl+O) when there is no portal file chooser'
            'kdialog: a file dialog for Open (Ctrl+O) when there is no portal file chooser'
            'noto-fonts-cjk: CJK text'
            'noto-fonts-emoji: color emoji')
options=('!lto' '!debug')
source=("$pkgname-$pkgver.tar.gz::$url/archive/v$pkgver.tar.gz")
sha256sums=('6ad72415f82fafddd8563e8be136cf3f08ca3287619b0b4b8771f800fbbf407d')

prepare() {
  cd "$pkgname-$pkgver"
  export RUSTUP_TOOLCHAIN=stable
  cargo fetch --locked --target "$(rustc -vV | sed -n 's/host: //p')"
}

build() {
  cd "$pkgname-$pkgver"
  export RUSTUP_TOOLCHAIN=stable
  export CARGO_TARGET_DIR=target
  # makepkg.conf's RUSTFLAGS replace the repository's .cargo/config.toml flags: keep its
  # packed relocations (RELR, smaller binary). The config's inline-threshold flag is left out on
  # purpose: this build honours the user's makepkg flags (e.g. opt-level=3), which a low inline
  # threshold would fight.
  export RUSTFLAGS="${RUSTFLAGS:-} -C link-arg=-Wl,-z,pack-relative-relocs"
  # Source paths in panic messages without the build directory or the crate registry's (as
  # `cargo xtask dist` builds them): the builder's home stays out of the binary.
  RUSTFLAGS+=" --remap-path-prefix=$PWD="
  local registry
  for registry in "${CARGO_HOME:-$HOME/.cargo}"/registry/src/*/; do
    RUSTFLAGS+=" --remap-path-prefix=${registry%/}="
  done
  # The binary aborts on panic, as the release profile says, whatever a cargo config file says;
  # it never uses its unwind tables, so they are left out by a linker script given to it alone
  # (not to the tests, which unwind). gold and mold don't take the script, and RUSTFLAGS asking
  # for panic=unwind override the profile: with any of them, the tables stay.
  export CARGO_PROFILE_RELEASE_PANIC=abort
  local link=() flags="$RUSTFLAGS ${CARGO_ENCODED_RUSTFLAGS:-}"
  if [[ $flags != *fuse-ld=mold* && $flags != *fuse-ld=gold* && $flags != *ld-path=*mold*
        && $flags != *ld-path=*gold* && $flags != *panic=unwind* ]]; then
    link=(-C link-arg=-Xlinker -C "link-arg=-T$PWD/packaging/discard-unwind.ld")
  fi
  cargo rustc --frozen --release --package vomd --bin vomd -- "${link[@]}"
}

check() {
  cd "$pkgname-$pkgver"
  export RUSTUP_TOOLCHAIN=stable
  export CARGO_TARGET_DIR=target
  cargo test --frozen --package vomd --lib
}

package() {
  cd "$pkgname-$pkgver"
  install -Dm755 target/release/vomd "$pkgdir/usr/bin/vomd"
  install -Dm644 packaging/vomd.desktop "$pkgdir/usr/share/applications/vomd.desktop"
  install -Dm644 assets/icon.svg "$pkgdir/usr/share/icons/hicolor/scalable/apps/vomd.svg"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 -t "$pkgdir/usr/share/licenses/$pkgname" \
    assets/fonts/LICENSE-Inter.txt assets/fonts/LICENSE-JetBrainsMono.txt assets/fonts/LICENSE-STIXTwoMath.txt \
    assets/fonts/LICENSE-Lucide.txt
  install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
  install -Dm644 -t "$pkgdir/usr/share/doc/$pkgname/assets" \
    assets/vomd-full-logo.svg assets/vomd-full-logo-light.svg \
    assets/screenshot-dark.png assets/screenshot-light.png
  install -Dm644 CHANGELOG.md "$pkgdir/usr/share/doc/$pkgname/CHANGELOG.md"
}
